# Copy to .env.local for local overrides. On Vercel, set these in Project Settings.

# Signs sign-in cookies. Any long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# One-time code to create the first admin at /login. Locally it defaults to "dev-setup".
SETUP_CODE=

# Added automatically when you connect a Vercel Blob store. Only used on Vercel,
# unless USE_BLOB_LOCALLY=1 (then local dev reads and writes the same store).
BLOB_READ_WRITE_TOKEN=
# USE_BLOB_LOCALLY=1
